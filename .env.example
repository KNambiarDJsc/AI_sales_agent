# Copy to .env and fill in. Nothing here is a real secret.
# Every value in this file is a PLACEHOLDER until the client supplies real credentials.

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-generate-a-real-secret
LOG_LEVEL=INFO

# --- Database ---
# Port 55434 (not the default 5432) on purpose: avoids silently colliding with a
# locally-installed native Postgres on the host, or with other local projects' docker
# Postgres containers — same symptom either way (TCP connects fine, but auth fails
# because you're talking to the wrong server). Matches docker-compose.yml's port
# mapping; change both together if you use a different port.
DATABASE_URL=postgresql+asyncpg://voiceagent:voiceagent@localhost:55434/voiceagent
DATABASE_URL_SYNC=postgresql+psycopg2://voiceagent:voiceagent@localhost:55434/voiceagent

# --- OpenAI (client-specified default for STT + TTS; also used for LLM until client says
# otherwise) ---
OPENAI_API_KEY=
# Chosen by measured latency on this project's prompt — see config/settings.py.
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_LLM_MODEL=gpt-4.1-mini
# Only for gpt-5.x reasoning models, e.g. OPENAI_LLM_MODEL=gpt-5.4-nano + "none".
OPENAI_LLM_REASONING_EFFORT=
# Language the customer is transcribed in (ISO-639-1); empty = auto-detect.
STT_LANGUAGE=en

# --- AI backend: OpenAI or local models ---
# auto   = OpenAI when the key works; each part falls back to the local model on its
#          own the moment OpenAI refuses (bad/expired key, no credits, no network),
#          mid-call, and OpenAI is retried after OPENAI_RETRY_AFTER_SECONDS.
# openai = OpenAI only.   local = local models only (no OpenAI calls at all).
# Local backup setup: pip install -r requirements-local.txt
#                     python scripts/setup_local_models.py
AI_BACKEND=auto
OPENAI_RETRY_AFTER_SECONDS=300
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:1.5b
LOCAL_STT_MODEL=base
LOCAL_TTS_VOICE=af_heart
# Load the local models when the server starts so the first local reply is fast.
LOCAL_PRELOAD=true

# STT backend: "buffered" (REST, per-utterance, default) or "realtime" (genuine
# streaming via OpenAI's Realtime API — live-verified, see STATUS.md, but not yet
# proven on a real phone call; flip after that, not before).
STT_BACKEND=buffered

# --- Telephony provider selection ---
# One of: twilio | exotel | frejun
TELEPHONY_PROVIDER=twilio

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_BASE_URL=https://your-public-host

# Exotel
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_APP_ID=

# FreJun / Teler — https://frejun.com/docs/teler/ (see telephony/frejun.py)
# API key: Teler dashboard -> Developers -> API Key (one per account).
FREJUN_API_KEY=
FREJUN_API_BASE_URL=https://api.frejun.ai/api/v1
# Webhook signing secret set on the Voice App that owns FREJUN_FROM_NUMBER.
FREJUN_SECRET=
# Your Teler virtual number in E.164 (e.g. +9180XXXXXXXX). Must be attached to a Voice App.
FREJUN_FROM_NUMBER=
FREJUN_SAMPLE_RATE=8k
FREJUN_CHUNK_SIZE_MS=100
FREJUN_RECORD=false

# Public https:// base URL of this app (tunnel in dev). FreJun's flow_url, media
# wss:// URL and status_callback_url are all built from it.
PUBLIC_BASE_URL=

# --- Campaign defaults (client must confirm) ---
DEFAULT_CALL_WINDOW_START=09:00
DEFAULT_CALL_WINDOW_END=19:00
DEFAULT_MAX_CALL_DURATION_SECONDS=420
DEFAULT_MAX_CONCURRENT_CALLS=3
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=voice-sales-agent
